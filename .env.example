# Copy to .env.local (gitignored). Never commit real secrets.

# Public URL of the app. Dev: http://localhost:3000
BETTER_AUTH_URL=https://your-app.vercel.app
# Signing secret for sessions. Generate with: bunx @better-auth/cli secret
BETTER_AUTH_SECRET=replace-with-a-generated-secret

# Used ONLY by the one-time /setup page to create the first administrator.
# At least 10 characters. Not stored in source code and never shown in the UI.
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
# Optional. Defaults to admin@example.com.
SEED_ADMIN_EMAIL=admin@example.com
